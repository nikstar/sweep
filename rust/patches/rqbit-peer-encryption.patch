+//! MSE interoperability adapter. Protocol/key exchange lives in urtorrent-mse;
+//! this module supplies bounded Tokio I/O and cancellation-safe stream wrapping.
+use crate::{
+    type_aliases::{BoxAsyncReadVectored, BoxAsyncWrite},
+    vectored_traits::AsyncReadVectoredIntoCompat,
+};
+use std::{
+    collections::VecDeque,
+    io,
+    pin::Pin,
+    task::{Context, Poll},
+};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, ReadBuf};
+use urtorrent_mse::{Initiator, Outcome, Rc4Stream, Responder, SkeyIndex};
+
+struct Randomness;
+impl urtorrent_profile::Rng for Randomness {
+    fn next_u32(&mut self) -> u32 {
+        rand::random()
+    }
+}
+
+type Streams = (BoxAsyncReadVectored, BoxAsyncWrite);
+
+pub(crate) async fn initiate(
+    mut read: BoxAsyncReadVectored,
+    mut write: BoxAsyncWrite,
+    info_hash: [u8; 20],
+    handshake: Vec<u8>,
+) -> anyhow::Result<Streams> {
+    let mut rng = Randomness;
+    let mut state = Initiator::new(info_hash, rand::random(), handshake, 3, &mut rng);
+    let mut buf = [0; 4096];
+    let mut received = 0;
+    loop {
+        write.write_all(&state.take_outbound()).await?;
+        let n = read.read(&mut buf).await?;
+        anyhow::ensure!(n > 0, "peer closed MSE handshake");
+        received += n;
+        anyhow::ensure!(received <= 80 * 1024, "oversized MSE handshake");
+        if let Some(outcome) = state.receive(&buf[..n], &mut rng)? {
+            write.write_all(&state.take_outbound()).await?;
+            return Ok(wrap(read, write, outcome));
+        }
+    }
+}
+
+pub(crate) async fn accept(
+    mut read: BoxAsyncReadVectored,
+    mut write: BoxAsyncWrite,
+    hashes: impl IntoIterator<Item = [u8; 20]>,
+) -> anyhow::Result<(Streams, bool)> {
+    let mut prefix = [0; 20];
+    read.read_exact(&mut prefix).await?;
+    if &prefix == b"\x13BitTorrent protocol" {
+        return Ok((
+            (
+                Box::new(
+                    CryptoRead {
+                        inner: read,
+                        cipher: None,
+                        prefix: prefix.into(),
+                    }
+                    .into_vectored_compat(),
+                ),
+                write,
+            ),
+            false,
+        ));
+    }
+    let mut keys = SkeyIndex::new();
+    for hash in hashes {
+        keys.insert(hash);
+    }
+    let mut state = Responder::new(rand::random(), 3, true);
+    let mut rng = Randomness;
+    let mut data = prefix.to_vec();
+    let mut received = data.len();
+    loop {
+        let outcome = state.receive(&data, &keys, &mut rng)?;
+        write.write_all(&state.take_outbound()).await?;
+        if let Some(outcome) = outcome {
+            return Ok((wrap(read, write, outcome), true));
+        }
+        data.resize(4096, 0);
+        let n = read.read(&mut data).await?;
+        anyhow::ensure!(n > 0, "peer closed MSE handshake");
+        received += n;
+        anyhow::ensure!(received <= 80 * 1024, "oversized MSE handshake");
+        data.truncate(n);
+    }
+}
+
+fn wrap(read: BoxAsyncReadVectored, write: BoxAsyncWrite, outcome: Outcome) -> Streams {
+    let read = Box::new(
+        CryptoRead {
+            inner: read,
+            cipher: outcome.decrypt,
+            prefix: outcome.plaintext.into(),
+        }
+        .into_vectored_compat(),
+    );
+    let write: BoxAsyncWrite = match outcome.encrypt {
+        Some(cipher) => Box::new(CryptoWrite {
+            inner: write,
+            cipher,
+            keystream: VecDeque::new(),
+            scratch: Vec::new(),
+        }),
+        None => write,
+    };
+    (read, write)
+}
+
+struct CryptoRead {
+    inner: BoxAsyncReadVectored,
+    cipher: Option<Rc4Stream>,
+    prefix: VecDeque<u8>,
+}
+impl AsyncRead for CryptoRead {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        if buf.remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+        if !this.prefix.is_empty() {
+            let n = buf.remaining().min(this.prefix.len());
+            for byte in this.prefix.drain(..n) {
+                buf.put_slice(&[byte]);
+            }
+            return Poll::Ready(Ok(()));
+        }
+        let start = buf.filled().len();
+        std::task::ready!(Pin::new(&mut this.inner).poll_read(cx, buf))?;
+        if let Some(cipher) = &mut this.cipher {
+            cipher.apply(&mut buf.filled_mut()[start..]);
+        }
+        Poll::Ready(Ok(()))
+    }
+}
+
+struct CryptoWrite {
+    inner: BoxAsyncWrite,
+    cipher: Rc4Stream,
+    // Precompute keystream, but consume it only for bytes the socket accepts.
+    // This handles partial writes, Pending, and cancellation without cipher drift.
+    keystream: VecDeque<u8>,
+    scratch: Vec<u8>,
+}
+impl AsyncWrite for CryptoWrite {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        input: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        let n = input.len().min(16 * 1024);
+        if this.keystream.len() < n {
+            let mut more = vec![0; n - this.keystream.len()];
+            this.cipher.apply(&mut more);
+            this.keystream.extend(more);
+        }
+        this.scratch.clear();
+        this.scratch
+            .extend(input[..n].iter().zip(&this.keystream).map(|(a, b)| a ^ b));
+        let written = std::task::ready!(Pin::new(&mut this.inner).poll_write(cx, &this.scratch))?;
+        this.keystream.drain(..written);
+        Poll::Ready(Ok(written))
+    }
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
