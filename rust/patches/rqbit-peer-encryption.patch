+    struct PartialWriter {
+        bytes: Arc<Mutex<Vec<u8>>>,
+        pending: bool,
+    }
+    impl AsyncWrite for PartialWriter {
+        fn poll_write(
+            mut self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            bytes: &[u8],
+        ) -> Poll<io::Result<usize>> {
+            if self.pending {
+                self.pending = false;
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            self.pending = true;
+            let n = bytes.len().min(3);
+            self.bytes.lock().unwrap().extend_from_slice(&bytes[..n]);
+            Poll::Ready(Ok(n))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+    #[tokio::test]
+    async fn sweep_mse_partial_pending_and_cancelled_writes_keep_cipher_position() {
+        let bytes = Arc::new(Mutex::new(Vec::new()));
+        let key = [5; 20];
+        let mut writer = CryptoWrite {
+            inner: Box::new(PartialWriter {
+                bytes: bytes.clone(),
+                pending: true,
+            }),
+            cipher: Rc4Stream::new(&key),
+            keystream: VecDeque::new(),
+            scratch: Vec::new(),
+        };
+        // Cancel a Pending write, then supply a different buffer and length.
+        std::future::poll_fn(|cx| {
+            assert!(
+                Pin::new(&mut writer)
+                    .poll_write(cx, &[99; 500])
+                    .is_pending()
+            );
+            Poll::Ready(())
+        })
+        .await;
+        let payload: Vec<u8> = (0..32777).map(|n| (n % 251) as u8).collect();
+        writer.write_all(&payload).await.unwrap();
+        writer.flush().await.unwrap();
+        let mut encrypted = bytes.lock().unwrap().clone();
+        assert_ne!(encrypted, payload);
+        Rc4Stream::new(&key).apply(&mut encrypted);
+        assert_eq!(encrypted, payload);
+    }
