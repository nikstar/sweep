+++ b/crates/librqbit/src/metadata_progress.rs
@@ -0,0 +1,37 @@
+use std::sync::Arc;
+use parking_lot::Mutex;
+use tracker_comms::TrackerCommsState;
+
+/// Live metadata discovery counters. Separate from payload-transfer statistics.
+#[derive(Clone, Debug, Default)]
+pub struct MetadataProgress {
+    inner: Arc<Mutex<MetadataProgressSnapshot>>,
+    pub trackers: TrackerCommsState,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct MetadataProgressSnapshot {
+    pub discovered: u64,
+    pub attempted: u64,
+    pub active: u64,
+    pub failed: u64,
+    pub last_error: Option<String>,
+}
+
+impl MetadataProgress {
+    pub fn snapshot(&self) -> MetadataProgressSnapshot { self.inner.lock().clone() }
+    pub(crate) fn discovered(&self) { self.inner.lock().discovered += 1; }
+    pub(crate) fn started(&self) {
+        let mut state = self.inner.lock();
+        state.attempted += 1;
+        state.active += 1;
+    }
+    pub(crate) fn finished(&self, error: Option<String>) {
+        let mut state = self.inner.lock();
+        state.active = state.active.saturating_sub(1);
+        if let Some(error) = error {
+            state.failed += 1;
+            state.last_error = Some(error);
+        }
+    }
+}
