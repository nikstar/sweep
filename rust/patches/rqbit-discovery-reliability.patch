+#[cfg(test)]
+mod sweep_persistence_tests {
+    use super::*;
+    use crate::Id20;
+
+    #[tokio::test]
+    async fn persists_both_families_and_rebinds_an_available_port() {
+        let dir = std::env::temp_dir().join(format!("sweep-dht-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("dht.json");
+        let id = Id20::new([1; 20]);
+        let mut v4 = RoutingTable::new(id, None);
+        v4.add_node(Id20::new([2; 20]), "127.0.0.1:1".parse().unwrap());
+        let mut v6 = RoutingTable::new(id, None);
+        v6.add_node(Id20::new([3; 20]), "[::1]:1".parse().unwrap());
+        let original = DhtState::with_config(DhtConfig {
+            peer_id: Some(id), routing_table: Some(v4), routing_table_v6: Some(v6),
+            bootstrap_addrs: Some(vec![]), ..Default::default()
+        }).await.unwrap();
+        dump_dht(&original, &path, &dir.join("dht.tmp")).unwrap();
+        let restored = PersistentDht::create(Some(PersistentDhtConfig {
+            config_filename: Some(path), port: Some(0), bootstrap_addrs: Some(vec![]),
+            ..Default::default()
+        }), None, None).await.unwrap();
+        assert_eq!(restored.stats().routing_table_size, 1);
+        assert_eq!(restored.stats().routing_table_size_v6, 1);
+        assert_eq!(restored.stats().responses, 0, "cached contacts are not fresh replies");
+        assert_ne!(original.listen_addr().port(), restored.listen_addr().port());
+        original.cancellation_token().cancel();
+        restored.cancellation_token().cancel();
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
