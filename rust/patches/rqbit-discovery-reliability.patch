+#[cfg(test)]
+mod sweep_discovery_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn successful_lookup_consumes_the_first_reply_without_querying_twice() {
+        let (tx, mut rx) = unbounded_channel();
+        let id = Id20::new([1; 20]);
+        let state = Arc::new(DhtState::new_internal(id, tx, None, None,
+            "127.0.0.1:0".parse().unwrap(), PeerStore::new(id), CancellationToken::new()));
+        let worker_state = state.clone();
+        let worker = tokio::spawn(async move {
+            let request = rx.recv().await.unwrap();
+            let (_, pending) = worker_state.inflight_by_transaction_id
+                .remove(&(request.our_tid.unwrap(), request.addr)).unwrap();
+            pending.done.send(Ok(ResponseOrError::Response(Response {
+                id: Id20::new([2; 20]), ..Default::default()
+            }))).unwrap();
+            // Keep the channel open, but never answer an erroneous second query.
+            tokio::time::sleep(Duration::from_secs(2)).await;
+        });
+        tokio::time::timeout(Duration::from_millis(500),
+            RecursiveRequest::find_node_for_routing_table(state.clone(), id,
+                ["127.0.0.1:12345".parse().unwrap()].into_iter()))
+            .await.expect("the successful first reply must finish the lookup").unwrap();
+        assert_eq!(state.get_stats().queries, 1);
+        assert_eq!(state.get_stats().responses, 1);
+        assert_eq!(state.get_stats().last_response_age_seconds, Some(0));
+        worker.abort();
+    }
+}
